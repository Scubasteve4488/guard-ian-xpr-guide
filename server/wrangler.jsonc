/**
 * GUARD.IAN XPR Guide server. Based on cloudflare/ai demos/remote-mcp-authless
 * (sha 0e5bc3b, read 2026-10-15). Wrangler config reference:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "guard-ian-guide",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true,
	},
	// Rate limiting (CLAUDE.md rule 10: no public surface without a rate limit).
	// https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	// period must be 10 or 60; limits are per Cloudflare location, per key (here: per client IP).
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "4488",
			"simple": { "limit": 60, "period": 60 },
		},
		// Never get banned (2026-10-16): budgets per TARGET, shared by every caller, so cache-busting cannot multiply
		// traffic to anyone. All XPR RPC + Hyperion reads share one key (about 7 hosts, so under ~9 requests/min/host
		// per location). rpc-queries.md:68 "10 seconds or more is plenty" for most state.
		{
			"name": "CHAIN_LIMITER",
			"namespace_id": "4489",
			"simple": { "limit": 60, "period": 60 },
		},
		{
			"name": "HOST_LIMITER",
			"namespace_id": "4490",
			"simple": { "limit": 20, "period": 60 },
		},
		// suggest_update only (1.7.0): per caller IP, 3 suggestions a minute. The IP is used for this count only, never stored.
		{
			"name": "SUGGEST_LIMITER",
			"namespace_id": "4491",
			"simple": { "limit": 3, "period": 60 },
		},
		// Public tier (2026-10-16): account, balance, history and holdings lookups get a tighter per-caller budget.
		{
			"name": "WALLET_LIMITER",
			"namespace_id": "4492",
			"simple": { "limit": 20, "period": 60 },
		},
		{
			// 1.15.0: Browser Run Quick Actions on Workers Free allow 1 request every 10 s (browser-run/limits/).
			"name": "BROWSER_LIMITER",
			"namespace_id": "4493",
			"simple": { "limit": 1, "period": 10 },
		},
	],
	// 1.15.0: Cloudflare Browser Run, used only by source_fetch for pages that build themselves in the browser.
	// Workers Free: 10 browser-minutes a day, then 429 until the next UTC day; never billed (browser-run/limits/).
	"browser": {
		"binding": "BROWSER",
	},
	// The private suggestion box (src/suggest.ts, schema in schema.sql). Builder's ruling 2026-10-16: "build the queue".
	// https://developers.cloudflare.com/workers/wrangler/configuration/#d1-databases
	"d1_databases": [
		{
			"binding": "SUGGESTIONS",
			"database_name": "guard-ian-suggestions",
			"database_id": "0d3b9337-d0d0-4284-afb5-e932a879ab6b",
		},
	],
	// Workers AI, used ONLY to turn PDFs into text in source_fetch (builder's yes 2026-10-16). Cloudflare's own Markdown
	// Conversion (developers.cloudflare.com/workers-ai/features/markdown-conversion/usage/binding/). Only PDFs are ever sent;
	// on the Free plan Workers AI cannot bill: past the 10,000 free Neurons a day a call fails (workers-ai/platform/pricing).
	"ai": {
		"binding": "AI",
	},
	"vars": {
		"GUIDE_REPO": "Scubasteve4488/guard-ian-xpr-guide",
		"GUIDE_BRANCH": "main",
	},
}
